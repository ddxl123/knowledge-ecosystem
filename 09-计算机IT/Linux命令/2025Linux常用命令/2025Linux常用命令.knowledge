# 2025Linux常用命令
# 领域: 计算机IT
# 学科: Linux
# 来源: 2025Linux常用命令
# 描述: Linux常用命令核心知识点

{{ls命令}}{{ls用于列出目录内容。常用选项：-l显示详细信息（权限、所有者、大小、日期），-a显示隐藏文件（以.开头），-h配合-l以人类可读格式显示文件大小，-R递归列出子目录内容，-t按修改时间排序，-S按文件大小排序。示例：ls -lah 显示当前目录下所有文件的详细信息。}}

{{cd命令}}{{cd用于切换工作目录。cd ~回到用户主目录，cd -回到上一次所在的目录，cd ..回到上级目录，cd /回到根目录。pwd命令可打印当前工作目录的完整路径。cd是shell内置命令，不是可执行文件。}}

{{cp命令}}{{cp用于复制文件和目录。-r或-R递归复制目录，-i覆盖前提示确认，-p保留文件权限和时间戳，-v显示复制过程，-u仅复制更新的文件。示例：cp -rvi src/ dest/ 递归复制并提示确认。}}

{{mv命令}}{{mv用于移动或重命名文件和目录。-i覆盖前提示，-u仅移动更新的文件，-v显示移动过程。在同一目录下mv相当于重命名。mv old.txt new.txt 将文件重命名。}}

{{rm命令}}{{rm用于删除文件和目录。-r递归删除目录，-f强制删除不提示，-i删除前逐一确认。rm -rf / 是极其危险的命令，会删除整个系统。建议使用trash命令替代rm，或设置alias rm='rm -i'增加安全提示。}}

{{mkdir命令}}{{mkdir用于创建目录。-p选项可递归创建多级目录，即父目录不存在时自动创建。-m选项可设置目录权限。示例：mkdir -p /path/to/deep/dir 一次性创建多层目录。rmdir用于删除空目录。}}

{{touch命令}}{{touch用于创建空文件或更新文件的时间戳。如果文件已存在，touch会更新其访问时间和修改时间。-a仅修改访问时间，-m仅修改修改时间，-c不创建不存在的文件。常用于创建空文件：touch newfile.txt。}}

{{cat命令}}{{cat用于查看文件内容或将多个文件合并输出。-n显示行号，-b仅对非空行编号，-s压缩连续空行为一行，-A显示所有非打印字符。cat file1 file2 > merged 合并两个文件。对于大文件，建议使用less或more分页查看。}}

{{less命令}}{{less是分页查看文件内容的工具，比more更强大。支持上下翻页（空格下翻，b上翻），/pattern向下搜索，?pattern向上搜索，n/N跳转下一个/上一个匹配，G跳到文件末尾，g跳到文件开头，q退出。支持管道输入：dmesg | less。}}

{{head和tail命令}}{{head查看文件开头内容，默认显示前10行。-n指定行数，-c指定字节数。tail查看文件末尾内容，默认显示后10行。tail -f 实时跟踪文件新增内容，常用于查看日志。tail -n 20 file 显示最后20行。head -c 100 file 显示前100字节。}}

{{grep命令}}{{grep用于文本搜索和模式匹配。-i忽略大小写，-r递归搜索目录，-n显示行号，-c仅显示匹配行数，-v反转匹配（显示不匹配的行），-E使用扩展正则表达式，-w全词匹配，-l仅显示包含匹配的文件名。grep -rn "error" /var/log/ 在日志目录中递归搜索error。}}

{{find命令}}{{find用于在目录树中搜索文件。按名称：find / -name "*.log"，按类型：find . -type d（目录）或f（文件），按大小：find . -size +100M，按时间：find . -mtime -7（7天内修改），按权限：find . -perm 755。-exec可对找到的文件执行命令：find . -name "*.tmp" -exec rm {} \;。}}

{{awk命令}}{{awk是强大的文本处理工具，按行处理文本并按字段分割。默认以空白字符分割字段，$1表示第一列，$0表示整行，NF表示字段数，NR表示行号。awk '{print $1, $3}' file 打印第1和第3列。awk -F: '{print $1}' /etc/passwd 以冒号分割打印第一列。支持条件过滤和编程逻辑。}}

{{sed命令}}{{sed是流编辑器，用于对文本进行替换、删除、插入等操作。s/old/new/g全局替换，-i直接修改文件（原地编辑），d删除行，p打印行，a追加行，i插入行。sed -i 's/localhost/127.0.0.1/g' config.txt 将文件中所有localhost替换为127.0.0.1。sed -n '10,20p' file 打印第10到20行。}}

{{管道和重定向}}{{管道|将前一个命令的输出作为后一个命令的输入。>重定向输出到文件（覆盖），>>追加输出到文件。<从文件读取输入。2>重定向错误输出，2>&1将错误输出合并到标准输出。&>同时重定向标准输出和错误输出。command > /dev/null 2>&1 丢弃所有输出。tee命令同时输出到屏幕和文件：ls | tee output.txt。}}

{{chmod命令}}{{chmod用于修改文件权限。数字模式：r=4,w=2,x=1，如chmod 755 file（所有者rwx，组和其他rx）。符号模式：u+x给所有者加执行权限，g-w去掉组写权限，o=r设置其他用户为只读，a+x给所有人加执行权限。-R递归修改目录。chmod +s设置SUID/SGID位。}}

{{chown命令}}{{chown用于修改文件所有者和所属组。chown user:group file 修改所有者和组，chown user file 仅修改所有者，chown :group file 仅修改组。-R递归修改目录及其内容。只有root用户可以修改文件所有者。示例：chown -R www-data:www-data /var/www。}}

{{ps命令}}{{ps用于查看进程状态。ps aux显示所有进程的详细信息（BSD风格），ps -ef显示所有进程（System V风格）。常用组合：ps aux | grep nginx 查找nginx进程。各列含义：PID进程号，%CPU CPU使用率，%MEM内存使用率，STAT进程状态，COMMAND命令行。}}

{{top和htop命令}}{{top实时显示系统进程信息，按CPU使用率排序。按M按内存排序，按P按CPU排序，按k杀死进程，按q退出。htop是top的增强版，支持彩色界面、鼠标操作、树状视图和水平/垂直滚动。系统监控首选htop，如未安装可用top替代。}}

{{kill和pkill命令}}{{kill用于向进程发送信号。kill PID发送SIGTERM(15)优雅终止，kill -9 PID发送SIGKILL强制终止，kill -HUP PID发送SIGHUP重新加载配置。pkill按进程名杀进程：pkill -f "python server"。killall按确切进程名杀进程。kill -l列出所有可用信号。}}

{{systemctl命令}}{{systemctl是systemd的服务管理工具。start启动服务，stop停止服务，restart重启服务，reload重新加载配置，status查看服务状态，enable设置开机启动，disable取消开机启动，list-units列出所有服务单元，is-active检查服务是否运行。示例：systemctl status nginx 查看nginx服务状态。}}

{{journalctl命令}}{{journalctl用于查看systemd日志。-u指定服务名：journalctl -u nginx，-f实时跟踪日志，--since和--until指定时间范围，-p按优先级过滤（0=emerg到7=debug），-n显示最近N行，--disk-usage查看日志占用空间。journalctl --since "2025-01-01" --until "2025-01-02" 查看指定日期日志。}}

{{df命令}}{{df用于查看磁盘空间使用情况。-h以人类可读格式显示（GB/MB），-T显示文件系统类型，-i显示inode使用情况。df -hT显示所有挂载点的磁盘使用情况和文件系统类型。当磁盘满但df显示有空间时，可能是inode耗尽，用df -i检查。}}

{{du命令}}{{du用于查看目录或文件的磁盘使用量。-h人类可读格式，-s仅显示总计，-d N限制深度，-a显示所有文件（不仅是目录）。du -sh /var/log 查看日志目录总大小。du -h --max-depth=1 / 查看根目录下各一级目录大小。常用组合：du -sh * | sort -rh | head 找出当前目录下最大的文件/目录。}}

{{free命令}}{{free用于查看内存使用情况。-h人类可读格式，-s N每N秒刷新一次，-t显示合计行。输出中：total总内存，used已使用，free空闲，shared共享内存，buff/cache缓冲/缓存，available可用内存（含可回收缓存）。available才是真正可用的内存量，不要看free列。}}

{{tar命令}}{{tar用于文件打包和压缩。-c创建归档，-x解压归档，-v显示过程，-f指定文件名，-z使用gzip压缩/解压，-j使用bzip2，-J使用xz。打包压缩：tar -czvf archive.tar.gz dir/，解压：tar -xzvf archive.tar.gz，解压到指定目录：tar -xzvf archive.tar.gz -C /target/。查看内容不解压：tar -tzvf archive.tar.gz。}}

{{wget命令}}{{wget用于从网络下载文件。-c断点续传，-O指定保存文件名，-q静默模式，-b后台下载，-r递归下载网站，-np不爬取父目录，--limit-rate限速。wget -c https://example.com/large.iso 断点续传大文件。wget -r -np -k https://example.com 递归下载整个网站。}}

{{curl命令}}{{curl是强大的网络请求工具。-o保存到文件，-O使用远程文件名保存，-L跟随重定向，-H设置请求头，-d发送POST数据，-X指定HTTP方法，-s静默模式，-v显示详细信息，-I仅获取响应头。curl -X POST -H "Content-Type: application/json" -d '{"key":"value"}' https://api.example.com。curl支持HTTP、HTTPS、FTP、SCP等多种协议。}}

{{ssh命令}}{{ssh用于远程登录和执行命令。ssh user@host 连接远程主机，-p指定端口，-i指定私钥文件，-L本地端口转发，-R远程端口转发，-D SOCKS代理。ssh user@host 'command' 在远程执行命令。~/.ssh/config可配置主机别名和默认参数。ssh-keygen生成密钥对，ssh-copy-id公钥部署到远程主机。}}

{{scp命令}}{{scp用于通过SSH安全复制文件。scp file user@host:/path 上传文件，scp user@host:/path file 下载文件，-r递归复制目录，-P指定端口，-C启用压缩。rsync是更高效的替代方案，支持增量同步：rsync -avz src/ user@host:/dest/。}}

{{ping命令}}{{ping用于测试网络连通性。发送ICMP回显请求包并等待回复。-c指定发送次数，-i指定间隔，-s指定包大小，-W超时时间。ping -c 4 google.com 发送4个包测试连通性。ping延迟（RTT）越低网络质量越好。某些服务器禁用ICMP会导致ping不通但服务正常。}}

{{netstat和ss命令}}{{netstat用于查看网络连接、路由表和接口统计。-t显示TCP连接，-u显示UDP连接，-l显示监听端口，-n以数字显示地址和端口，-p显示关联的进程。ss是netstat的现代替代，速度更快。ss -tlnp 显示所有TCP监听端口及对应进程。ss -s 显示连接统计摘要。}}

{{iptables和nftables命令}}{{iptables是传统的Linux防火墙工具。-L列出规则，-A追加规则，-D删除规则，-I插入规则。iptables -A INPUT -p tcp --dport 80 -j ACCEPT 允许80端口TCP流量。nftables是iptables的继任者，语法更统一。常用操作：iptables -L -n -v 查看当前规则和流量统计。firewalld是更高层的防火墙管理工具。}}

{{lsof命令}}{{lsof列出打开的文件。在Linux中一切皆文件，lsof可查看进程打开的文件、网络连接等。-i查看网络连接，-p指定PID，-u指定用户，+D递归查看目录。lsof -i :80 查看占用80端口的进程。lsof -p PID 查看某进程打开的所有文件。常用：找出哪个进程占用某个端口或文件。}}

{{strace命令}}{{strace用于跟踪系统调用和信号。-p附加到运行中的进程，-e过滤特定系统调用，-f跟踪子进程，-c统计系统调用次数和耗时，-o输出到文件。strace -p PID 跟踪进程的系统调用。strace -e trace=open,read ls 跟踪ls命令的open和read调用。调试程序崩溃、性能问题的利器。}}

{{crontab命令}}{{crontab用于设置定时任务。-l列出当前用户的定时任务，-e编辑定时任务，-r删除所有定时任务。格式：分 时 日 月 周 命令。*表示每，,分隔多个值，-表示范围，/表示间隔。30 2 * * * /path/script.sh 每天凌晨2:30执行。*/5 * * * * command 每5分钟执行。0 0 * * 0 command 每周日零点执行。}}

{{date命令}}{{date用于显示和设置系统时间。+%Y-%m-%d自定义格式输出，-d解析日期字符串，-s设置系统时间。date +%Y-%m-%d\ %H:%M:%S 显示完整日期时间。date -d "3 days ago" +%Y-%m-%d 三天前的日期。date -d @1700000000 将Unix时间戳转为可读日期。clockdiff和ntpd用于时间同步。}}

{{uname命令}}{{uname显示系统信息。-a显示所有信息，-r显示内核版本，-m显示机器架构，-n显示主机名，-o显示操作系统名称。uname -r 常用于查看内核版本以确认兼容性。/etc/os-release文件包含更详细的发行版信息。hostnamectl可查看和设置主机名。}}

{{which和whereis命令}}{{which在PATH中查找可执行文件的位置。which python3 查找python3的路径。-a显示所有匹配项。whereis查找命令的二进制文件、源代码和手册页位置。type命令也可判断命令类型（内置、别名、外部命令）。command -v cmd 是POSIX兼容的查找方式。}}

{{man和info命令}}{{man用于查看命令的手册页。man ls 查看ls的手册。man 5 crontab 查看第5节（配置文件格式）。/keyword在手册中搜索，n跳转下一个匹配。info提供比man更详细的文档，以节点方式组织。whatis显示命令的简短描述，apropos搜索手册页中的关键字。tldr提供更简洁的命令用法示例。}}

{{history命令}}{{history显示命令历史记录。!N执行第N条历史命令，!!执行上一条命令，!str执行最近以str开头的命令。Ctrl+R反向搜索历史命令。history -c清空历史记录。HISTSIZE和HISTFILESIZE控制历史记录数量。history | grep keyword 搜索历史命令。fc可编辑并执行历史命令。}}

{{alias命令}}{{alias为常用命令创建别名。alias ll='ls -alF'创建别名。unalias删除别名。alias不带参数显示所有别名。永久别名写入~/.bashrc或~/.zshrc。常用别名：alias rm='rm -i'，alias cp='cp -i'，alias gs='git status'。函数比别名更灵活，可接受参数和包含多条命令。}}

{{xargs命令}}{{xargs从标准输入构建命令行参数。-I指定替换字符串，-N指定每次传递的参数个数，-P并行执行，-0配合find -print0处理特殊字符。find . -name "*.log" | xargs rm 删除所有日志文件。echo "1 2 3" | xargs -n 1 echo 每次传递一个参数。cat urls.txt | xargs -P 4 -I {} curl -O {} 并行下载。}}

{{tee命令}}{{tee从标准输入读取并同时写入标准输出和文件。-a追加到文件。ls | tee output.txt 将ls的输出同时显示在屏幕和写入文件。常用于管道中间：command | tee log.txt | grep error。需要同时查看和保存输出时非常有用。}}

{{sort和uniq命令}}{{sort对文本行排序。-n按数字排序，-r逆序，-k指定排序字段，-u去重，-t指定分隔符，-f忽略大小写。uniq去除相邻重复行，-c统计出现次数，-d仅显示重复行，-u仅显示唯一行。sort file | uniq -c | sort -rn 找出出现次数最多的行。sort -t: -k3 -n /etc/passwd 按UID数值排序。}}

{{wc命令}}{{wc统计文件的行数、单词数和字节数。-l仅统计行数，-w仅统计单词数，-c仅统计字节数，-m统计字符数。wc -l file 统计文件行数。ls | wc -l 统计当前目录文件数。常与其他命令结合使用：grep -c等价于grep | wc -l。}}

{{diff和patch命令}}{{diff比较两个文件的差异。-u统一格式输出（最常用），-y并排比较，-r递归比较目录，-q仅报告是否不同。diff -u old.txt new.txt > changes.patch 生成补丁文件。patch < changes.patch 应用补丁。git diff是diff的增强版，与版本控制集成。}}

{{zip和unzip命令}}{{zip用于创建zip压缩文件。-r递归压缩目录，-e加密压缩，-9最高压缩比，-q静默模式。zip -r archive.zip dir/ 压缩目录。unzip解压zip文件，-l查看内容不解压，-o覆盖已有文件不提示，-d指定解压目录。unzip -l archive.zip 查看压缩包内容。gzip/gunzip处理.gz文件，bzip2处理.bz2文件。}}
